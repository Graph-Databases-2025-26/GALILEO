    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {\n",
    "    \"collapsed\": true,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-12-13T13:43:19.662368Z\",\n",
    "     \"start_time\": \"2025-12-13T13:43:19.549663Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import json\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Questo comando magico fa apparire i grafici direttamente nel notebook\\n\",\n",
    "    \"%matplotlib inline\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 1. DATI (Modifica qui i tuoi numeri!)\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Categorie di complessità (Asse X)\\n\",\n",
    "    \"categories = ['SP2', 'SP2>', 'DIST', 'AGGR', 'G/O', 'JOIN']\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Dati Baseline (Approssimati dal Paper)\\n\",\n",
    "    \"data_paper_quality = {\\n\",\n",
    "    \"    'NL':        [0.38, 0.39, 0.37, 0.29, 0.25, 0.25],\\n\",\n",
    "    \"    'SQL':       [0.55, 0.54, 0.56, 0.50, 0.49, 0.49],\\n\",\n",
    "    \"    'GALOIS_WO': [0.57, 0.55, 0.57, 0.52, 0.55, 0.53],\\n\",\n",
    "    \"    'GALOIS_A':  [0.66, 0.63, 0.64, 0.58, 0.59, 0.59],\\n\",\n",
    "    \"    'GALOIS_F':  [0.67, 0.65, 0.65, 0.61, 0.62, 0.62]\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- I TUOI RISULTATI ATTUALI ---\\n\",\n",
    "    \"# Copia qui i valori che leggi dal terminale dopo aver eseguito exp_5_runner.py\\n\",\n",
    "    \"# my_run_values = [0.2342, 0.4524, 0.3987, 0.2917, 0.4679, 0.0000]\\n\",\n",
    "    \"\\n\",\n",
    "    \"summary_file = \\\"exp5_summary.json\\\"\\n\",\n",
    "    \"if os.path.exists(summary_file):\\n\",\n",
    "    \"    with open(summary_file, \\\"r\\\") as f:\\n\",\n",
    "    \"        summary_data = json.load(f)\\n\",\n",
    "    \"    print(f\\\"Summary data loaded from {summary_file}:\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    my_run_values = [summary_data.get(cat, 0.0) for cat in categories]\\n\",\n",
    "    \"    print(f\\\"My run values: {my_run_values}\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(f\\\"Summary file {summary_file} not found!\\\")\\n\",\n",
    "    \"    my_run_values = [0.0] * len(categories)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 2. CONFIGURAZIONE GRAFICA\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Definizione stili (Colori e Simboli)\\n\",\n",
    "    \"styles = {\\n\",\n",
    "    \"    'NL':        {'color': '#0099ff', 'marker': 'o', 'linestyle': '-', 'label': 'NL'},\\n\",\n",
    "    \"    'SQL':       {'color': '#6666ff', 'marker': 's', 'linestyle': '-', 'label': 'SQL'},\\n\",\n",
    "    \"    'GALOIS_WO': {'color': '#cc6699', 'marker': 'o', 'linestyle': '-', 'label': r'GALOIS $_{WO}$'},\\n\",\n",
    "    \"    'GALOIS_A':  {'color': '#ffcc66', 'marker': 'D', 'linestyle': '-', 'label': r'GALOIS $_A$'},\\n\",\n",
    "    \"    'GALOIS_F':  {'color': '#ff6666', 'marker': 'd', 'linestyle': '-', 'label': r'GALOIS $_F$'},\\n\",\n",
    "    \"    'MY RUN':    {'color': 'green',   'marker': 'X', 'linestyle': '--', 'linewidth': 3, 'label': 'MY RUN (Current)'}\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Creazione Figura\\n\",\n",
    "    \"plt.figure(figsize=(12, 6), facecolor='white')\\n\",\n",
    "    \"plt.rcParams['font.family'] = 'serif'\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 3. PLOT\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"# A. Plotta le Baseline\\n\",\n",
    "    \"for name, values in data_paper_quality.items():\\n\",\n",
    "    \"    s = styles[name]\\n\",\n",
    "    \"    plt.plot(categories, values,\\n\",\n",
    "    \"             color=s['color'], marker=s['marker'], linestyle=s['linestyle'],\\n\",\n",
    "    \"             label=s['label'], linewidth=2, markersize=6, alpha=0.6)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# B. Plotta la TUA linea (in evidenza)\\n\",\n",
    "    \"s_my = styles['MY RUN']\\n\",\n",
    "    \"plt.plot(categories, my_run_values,\\n\",\n",
    "    \"         color=s_my['color'], marker=s_my['marker'], linestyle=s_my['linestyle'],\\n\",\n",
    "    \"         label=s_my['label'], linewidth=3, markersize=10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 4. PERSONALIZZAZIONE FINALE\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"#plt.title(\\\"Exp 5: Result quality w.r.t Query Complexity\\\", fontsize=14, pad=20)\\n\",\n",
    "    \"plt.ylabel(\\\"AVG-SCORE\\\", fontsize=12)\\n\",\n",
    "    \"plt.xlabel(\\\"Complexity Category\\\", fontsize=12)\\n\",\n",
    "    \"plt.ylim(0, 0.8)\\n\",\n",
    "    \"plt.grid(axis='y', linestyle='--', alpha=0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Legenda esterna in alto\\n\",\n",
    "    \"plt.legend(loc='upper center', bbox_to_anchor=(0.5, 1.15), ncol=3, frameon=True, edgecolor='black')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
