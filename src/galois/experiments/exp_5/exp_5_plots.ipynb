    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    },\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1200x600 with 1 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 11,\n",
    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Forziamo i colori per assicurarci che si vedano su sfondo bianco\\n\",\n",
    "    \"plt.rcParams.update({\\n\",\n",
    "    \"    'text.color': 'black',\\n\",\n",
    "    \"    'axes.labelcolor': 'black',\\n\",\n",
    "    \"    'xtick.color': 'black',\\n\",\n",
    "    \"    'ytick.color': 'black',\\n\",\n",
    "    \"    'font.family': 'serif',\\n\",\n",
    "    \"    'font.size': 12\\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Definizione stili (Uguale per entrambi i grafici)\\n\",\n",
    "    \"styles = {\\n\",\n",
    "    \"    'NL':        {'color': '#0099ff', 'marker': 'o', 'linestyle': '-', 'label': 'NL'},\\n\",\n",
    "    \"    'SQL':       {'color': '#6666ff', 'marker': 's', 'linestyle': '-', 'label': 'SQL'},\\n\",\n",
    "    \"    'GALOIS_WO': {'color': '#a64d79', 'marker': 'o', 'linestyle': '-', 'label': r'GALOIS $_{WO}$'},\\n\",\n",
    "    \"    'GALOIS_A':  {'color': '#ffcc66', 'marker': 'D', 'linestyle': '-', 'label': r'GALOIS $_A$'},\\n\",\n",
    "    \"    'GALOIS_F':  {'color': '#ff6666', 'marker': 'd', 'linestyle': '-', 'label': r'GALOIS $_F$'},\\n\",\n",
    "    \"    'OUR RUN':    {'color': 'green',   'marker': 'X', 'linestyle': '--', 'linewidth': 3, 'label': 'OUR RUN (Current)'}\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_paper_tokens = {\\n\",\n",
    "    \"    'NL':        [420, 430, 450, 500, 550, 560],\\n\",\n",
    "    \"    'SQL':       [200, 210, 220, 250, 280, 290],\\n\",\n",
    "    \"    'GALOIS_A':  [480, 520, 550, 700, 890, 960],\\n\",\n",
    "    \"    'GALOIS_F':  [560, 610, 900, 1190, 1430, 1720]\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 3. PLOT 1: AVG SCORE\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"plt.figure(figsize=(12, 6), facecolor='white')\\n\",\n",
    "    \"ax1 = plt.gca()\\n\",\n",
    "    \"ax1.set_facecolor('white')\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"for name, values in data_paper_quality.items():\\n\",\n",
    "    \"    s = styles[name]\\n\",\n",
    "    \"    plt.plot(categories, values,\\n\",\n",
    "    \"             color=s['color'], marker=s['marker'], linestyle=s['linestyle'],\\n\",\n",
    "    \"             label=s['label'], linewidth=2, markersize=8, alpha=0.7)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"s_my = styles['OUR RUN']\\n\",\n",
    "    \"plt.plot(categories, my_run_values,\\n\",\n",
    "    \"         color=s_my['color'], marker=s_my['marker'], linestyle=s_my['linestyle'],\\n\",\n",
    "    \"         label=s_my['label'], linewidth=3, markersize=12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.ylabel(\\\"AVG-SCORE\\\", fontsize=14, color='black')\\n\",\n",
    "    \"plt.xlabel(\\\"Complexity Category\\\", fontsize=14, color='black')\\n\",\n",
    "    \"plt.ylim(0, 1.05)\\n\",\n",
    "    \"plt.grid(axis='y', linestyle='--', alpha=0.5, color='gray')\\n\",\n",
    "    \"plt.legend(loc='upper center', bbox_to_anchor=(0.5, 1.15), ncol=6, frameon=True, edgecolor='black', facecolor='white')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 4. PLOT 2: TOKENS CONSUMED\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"plt.figure(figsize=(12, 6), facecolor='white')\\n\",\n",
    "    \"ax2 = plt.gca()\\n\",\n",
    "    \"ax2.set_facecolor('white')\\n\",\n",
    "    \"\\n\",\n",
    "    \"for name, values in data_paper_tokens.items():\\n\",\n",
    "    \"    s = styles[name]\\n\",\n",
    "    \"    plt.plot(categories, values,\\n\",\n",
    "    \"             color=s['color'], marker=s['marker'], linestyle=s['linestyle'],\\n\",\n",
    "    \"             label=s['label'], linewidth=2, markersize=8, alpha=0.7)\\n\",\n",
    "    \"\\n\",\n",
    "    \"s_my = styles['OUR RUN']\\n\",\n",
    "    \"plt.plot(categories, my_token_values,\\n\",\n",
    "    \"         color=s_my['color'], marker=s_my['marker'], linestyle=s_my['linestyle'],\\n\",\n",
    "    \"         label=s_my['label'], linewidth=3, markersize=12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.ylabel(\\\"Average Tokens\\\", fontsize=14, color='black')\\n\",\n",
    "    \"plt.xlabel(\\\"Complexity Category\\\", fontsize=14, color='black')\\n\",\n",
    "    \"plt.grid(axis='y', linestyle='--', alpha=0.5, color='gray')\\n\",\n",
    "    \"plt.title(\\\"\\\", fontsize=14, pad=20, color='black')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.legend(loc='upper center', bbox_to_anchor=(0.5, 1.15), ncol=5, frameon=True, edgecolor='black', facecolor='white')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
