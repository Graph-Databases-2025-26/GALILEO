   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"Importing libraries\",\n",
    "   \"id\": \"ee3a149bbf259ffa\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import json\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"import matplotlib.pyplot as plt\"\n",
    "   ],\n",
    "   \"execution_count\": null,\n",
    "   \"outputs\": []\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Data configuration ( data from the paper and out results )\",\n",
    "   \"id\": \"42e6523d324e8ae8\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"# Questo comando magico fa apparire i grafici direttamente nel notebook\\n\",\n",
    "    \"%matplotlib inline\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Categorie di complessità (Asse X)\\n\",\n",
    "    \"categories = ['SP2', 'SP2>', 'DIST', 'AGGR', 'G/O', 'JOIN']\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Dati Baseline (Approssimati dal Paper)\\n\",\n",
    "    \"data_paper_quality = {\\n\",\n",
    "    \"    'NL':        [0.38, 0.39, 0.37, 0.29, 0.25, 0.25],\\n\",\n",
    "    \"    'SQL':       [0.55, 0.54, 0.56, 0.50, 0.49, 0.49],\\n\",\n",
    "    \"    'GALOIS_WO': [0.57, 0.55, 0.57, 0.52, 0.55, 0.53],\\n\",\n",
    "    \"    'GALOIS_A':  [0.66, 0.63, 0.64, 0.58, 0.59, 0.59],\\n\",\n",
    "    \"    'GALOIS_F':  [0.67, 0.65, 0.65, 0.61, 0.62, 0.62]\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"#  TOKENS (Dal Paper - Approssimati dall'immagine 3)\\n\",\n",
    "    \"data_paper_tokens = {\\n\",\n",
    "    \"    'NL':        [420, 430, 450, 500, 550, 560],\\n\",\n",
    "    \"    'SQL':       [200, 210, 220, 250, 280, 290],\\n\",\n",
    "    \"    'GALOIS_WO': [0, 0, 0, 0, 0, 0], # Spesso non riportato per i token, messo a 0\\n\",\n",
    "    \"    'GALOIS_A':  [480, 520, 550, 700, 890, 960],\\n\",\n",
    "    \"    'GALOIS_F':  [560, 610, 900, 1190, 1430, 1720]\\n\",\n",
    "    \"}\"\n",
    "   ],\n",
    "   \"id\": \"76eed9603b6b614d\",\n",
    "   \"outputs\": []\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"## Data Loading\\n\",\n",
    "    \"Loading the avg score data and tokens from json file\"\n",
    "   ],\n",
    "   \"id\": \"111275f1efd22cb0\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"# --- I TUOI RISULTATI ATTUALI ---\\n\",\n",
    "    \"\\n\",\n",
    "    \"summary_file = \\\"exp5_summary.json\\\"\\n\",\n",
    "    \"token_file = \\\"exp5_tokens_summary.json\\\"\\n\",\n",
    "    \"if os.path.exists(summary_file):\\n\",\n",
    "    \"    with open(summary_file, \\\"r\\\") as f:\\n\",\n",
    "    \"        summary_data = json.load(f)\\n\",\n",
    "    \"    print(f\\\"Summary data loaded from {summary_file}:\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    my_run_values = [summary_data.get(cat, 0.0) for cat in categories]\\n\",\n",
    "    \"    print(f\\\"My run values: {my_run_values}\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(f\\\"Summary file {summary_file} not found!\\\")\\n\",\n",
    "    \"    my_run_values = [0.0] * len(categories)\\n\",\n",
    "    \"\\n\",\n",
    "    \"token_file = \\\"exp5_tokens_summary.json\\\"\\n\",\n",
    "    \"if os.path.exists(token_file):\\n\",\n",
    "    \"    with open(token_file, \\\"r\\\") as f:\\n\",\n",
    "    \"        token_data = json.load(f)\\n\",\n",
    "    \"    print(f\\\"Token data loaded from {token_file}\\\")\\n\",\n",
    "    \"    my_token_values = [token_data.get(cat, 0.0) for cat in categories]\\n\",\n",
    "    \"    print(f\\\"My Token values: {my_token_values}\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(f\\\"[WARN] Token file {token_file} not found! Using zeros.\\\")\\n\",\n",
    "    \"    my_token_values = [0.0] * len(categories)\\n\"\n",
    "   ],\n",
    "   \"id\": \"eca4a77c4f9c0517\",\n",
    "   \"outputs\": []\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"## Data plotting\\n\",\n",
    "    \"Plotting th data splitted in two graphs: avg score and tokens consumed, both compared with the data from the paper.\\n\",\n",
    "    \"Here is defined also the styles for the plots.\"\n",
    "   ],\n",
    "   \"id\": \"a5518e5146bf9773\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Summary data loaded from exp5_summary.json:\\n\",\n",
    "      \"My run values: [0.2453507292118227, 0.3453196159717899, 0.3522631944507454, 0.33548043591147036, 0.4944849690539346, 0.011111111111111112]\\n\",\n",
    "      \"Token data loaded from exp5_tokens_summary.json\\n\",\n",
    "      \"My Token values: [886.5333333333333, 1090, 479.6666666666667, 841.72, 1176.8, 2802.6666666666665]\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1200x600 with 1 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
